#!/bin/sh
# Wrapper that downloads pinned `just` and Godot releases (see env/) and runs just.
set -eu

ROOT=$(cd "$(dirname "$0")" && pwd)
ENV_DIR="${ROOT}/env"

os=$(uname -s)
arch=$(uname -m)

case "$os" in
  Linux) plat=linux.sh ;;
  Darwin) plat=mac.sh ;;
  MINGW* | MSYS* | CYGWIN*) plat=win.sh ;;
  *)
    echo "justw: unsupported operating system: $os" >&2
    exit 1
    ;;
esac

. "${ENV_DIR}/conf.sh"
. "${ENV_DIR}/conf_${plat}"

JUST_INSTALL_DIR="${ROOT}/${JUST_INSTALL_DIR}"
GODOT_INSTALL_DIR="${ROOT}/${GODOT_INSTALL_DIR}"

JUST_BIN="$JUST_INSTALL_DIR/$JUST_EXECUTABLE"
GODOT_BIN="$GODOT_INSTALL_DIR/$GODOT_RELATIVE_PATH"

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    echo "justw: curl or wget is required" >&2
    exit 1
  fi
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    echo "justw: sha256sum or shasum is required" >&2
    exit 1
  fi
}

sha512() {
  if command -v sha512sum >/dev/null 2>&1; then
    sha512sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 512 "$1" | cut -d ' ' -f 1
  else
    echo "justw: sha512sum or shasum is required" >&2
    exit 1
  fi
}

require_unzip() {
  if ! command -v unzip >/dev/null 2>&1; then
    echo "justw: unzip is required to extract ZIP archives; install unzip and rerun" >&2
    exit 1
  fi
}

install_godot() {
  require_unzip
  url="$GODOT_DOWNLOAD_URL"
  archive="${url##*/}"
  tmp=$(mktemp -d)

  echo "justw: downloading $archive" >&2
  fetch "$url" "$tmp/$archive"
  fetch "${url%/*}/SHA512-SUMS.txt" "$tmp/SHA512-SUMS.txt"

  expected=$(grep " \*\?$archive\$" "$tmp/SHA512-SUMS.txt" | cut -d ' ' -f 1)
  if [ -z "$expected" ]; then
    rm -rf "$tmp"
    echo "justw: no checksum found for $archive" >&2
    exit 1
  fi
  if [ "$(sha512 "$tmp/$archive")" != "$expected" ]; then
    rm -rf "$tmp"
    echo "justw: checksum mismatch for $archive" >&2
    exit 1
  fi

  mkdir -p "$GODOT_INSTALL_DIR"
  unzip -qo "$tmp/$archive" -d "$GODOT_INSTALL_DIR"
  rm -rf "$tmp"
  chmod +x "$GODOT_BIN"
}

install_just() {
  if [ "$JUST_ARCHIVE_EXT" = zip ]; then
    require_unzip
  fi
  archive="just-$JUST_VERSION-$JUST_TARGET.$JUST_ARCHIVE_EXT"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  echo "justw: downloading $archive" >&2
  fetch "$JUST_BASE_URL/$archive" "$tmp/$archive"
  fetch "$JUST_BASE_URL/SHA256SUMS" "$tmp/SHA256SUMS"

  expected=$(grep " \*\?$archive\$" "$tmp/SHA256SUMS" | cut -d ' ' -f 1)
  if [ -z "$expected" ]; then
    echo "justw: no checksum found for $archive" >&2
    exit 1
  fi
  if [ "$(sha256 "$tmp/$archive")" != "$expected" ]; then
    echo "justw: checksum mismatch for $archive" >&2
    exit 1
  fi

  mkdir -p "$JUST_INSTALL_DIR"
  if [ "$JUST_ARCHIVE_EXT" = zip ]; then
    unzip -qo "$tmp/$archive" "$JUST_EXECUTABLE" -d "$JUST_INSTALL_DIR"
  else
    tar -xzf "$tmp/$archive" -C "$JUST_INSTALL_DIR" "$JUST_EXECUTABLE"
  fi
  chmod +x "$JUST_BIN"
  rm -rf "$tmp"
  trap - EXIT
}

if [ ! -x "$JUST_BIN" ]; then
  install_just
else
  echo "justw: just is already downloaded" >&2
fi

if [ ! -x "$GODOT_BIN" ]; then
  install_godot
else
  echo "justw: Godot is already downloaded" >&2
fi

export GODOT_BIN
exec "$JUST_BIN" "$@"
