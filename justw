#!/bin/sh
# Wrapper that downloads pinned `just` and Godot releases (see env/) and runs just.
set -eu

ROOT=$(cd "$(dirname "$0")" && pwd)
ENV_DIR="${ROOT}/env"

os=$(uname -s)
arch=$(uname -m)

case "$os" in
  Linux)
    plat=linux.sh
    ext=tar.gz
    exe=just
    case "$arch" in
      x86_64 | amd64) target=x86_64-unknown-linux-musl ;;
      aarch64 | arm64) target=aarch64-unknown-linux-musl ;;
      armv7l) target=armv7-unknown-linux-musleabihf ;;
      armv6l) target=arm-unknown-linux-musleabihf ;;
      *) echo "justw: unsupported Linux architecture: $arch" >&2; exit 1 ;;
    esac
    ;;
  Darwin)
    plat=mac.sh
    ext=tar.gz
    exe=just
    case "$arch" in
      x86_64) target=x86_64-apple-darwin ;;
      arm64 | aarch64) target=aarch64-apple-darwin ;;
      *) echo "justw: unsupported macOS architecture: $arch" >&2; exit 1 ;;
    esac
    ;;
  MINGW* | MSYS* | CYGWIN*)
    plat=win.sh
    ext=zip
    exe=just.exe
    case "$arch" in
      x86_64 | amd64) target=x86_64-pc-windows-msvc ;;
      aarch64 | arm64) target=aarch64-pc-windows-msvc ;;
      *) echo "justw: unsupported Windows architecture: $arch" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "justw: unsupported operating system: $os" >&2
    exit 1
    ;;
esac

. "${ENV_DIR}/conf.sh"
. "${ENV_DIR}/conf_${plat}"

JUST_INSTALL_DIR="${ROOT}/${JUST_INSTALL_DIR}"
GODOT_INSTALL_DIR="${ROOT}/${GODOT_INSTALL_DIR}"

case "$os" in
  Linux) godot_rel="Godot_v${GODOT_VERSION}_linux.x86_64" ;;
  Darwin) godot_rel="Godot.app/Contents/MacOS/Godot" ;;
  *) godot_rel="Godot_v${GODOT_VERSION}_win64_console.exe" ;;
esac

JUST_BIN="$JUST_INSTALL_DIR/$exe"
GODOT_BIN="$GODOT_INSTALL_DIR/$godot_rel"

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    echo "justw: curl or wget is required" >&2
    exit 1
  fi
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
  else
    echo "justw: sha256sum or shasum is required" >&2
    exit 1
  fi
}

sha512() {
  if command -v sha512sum >/dev/null 2>&1; then
    sha512sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 512 "$1" | cut -d ' ' -f 1
  else
    echo "justw: sha512sum or shasum is required" >&2
    exit 1
  fi
}

install_godot() {
  url="$GODOT_DOWNLOAD_URL"
  archive="${url##*/}"
  tmp=$(mktemp -d)

  echo "justw: downloading $archive" >&2
  fetch "$url" "$tmp/$archive"
  fetch "${url%/*}/SHA512-SUMS.txt" "$tmp/SHA512-SUMS.txt"

  expected=$(grep " \*\?$archive\$" "$tmp/SHA512-SUMS.txt" | cut -d ' ' -f 1)
  if [ -z "$expected" ]; then
    rm -rf "$tmp"
    echo "justw: no checksum found for $archive" >&2
    exit 1
  fi
  if [ "$(sha512 "$tmp/$archive")" != "$expected" ]; then
    rm -rf "$tmp"
    echo "justw: checksum mismatch for $archive" >&2
    exit 1
  fi

  mkdir -p "$GODOT_INSTALL_DIR"
  if command -v unzip >/dev/null 2>&1; then
    unzip -qo "$tmp/$archive" -d "$GODOT_INSTALL_DIR"
  else
    tar -xf "$tmp/$archive" -C "$GODOT_INSTALL_DIR"
  fi
  rm -rf "$tmp"
  chmod +x "$GODOT_BIN"
}

install_just() {
  archive="just-$JUST_VERSION-$target.$ext"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  echo "justw: downloading $archive" >&2
  fetch "$JUST_BASE_URL/$archive" "$tmp/$archive"
  fetch "$JUST_BASE_URL/SHA256SUMS" "$tmp/SHA256SUMS"

  expected=$(grep " \*\?$archive\$" "$tmp/SHA256SUMS" | cut -d ' ' -f 1)
  if [ -z "$expected" ]; then
    echo "justw: no checksum found for $archive" >&2
    exit 1
  fi
  if [ "$(sha256 "$tmp/$archive")" != "$expected" ]; then
    echo "justw: checksum mismatch for $archive" >&2
    exit 1
  fi

  mkdir -p "$JUST_INSTALL_DIR"
  if [ "$ext" = zip ]; then
    if command -v unzip >/dev/null 2>&1; then
      unzip -qo "$tmp/$archive" "$exe" -d "$JUST_INSTALL_DIR"
    else
      tar -xf "$tmp/$archive" -C "$JUST_INSTALL_DIR" "$exe"
    fi
  else
    tar -xzf "$tmp/$archive" -C "$JUST_INSTALL_DIR" "$exe"
  fi
  chmod +x "$JUST_BIN"
}

if [ ! -x "$JUST_BIN" ]; then
  install_just
fi

if [ ! -x "$GODOT_BIN" ]; then
  install_godot
fi

export GODOT_BIN
exec "$JUST_BIN" "$@"
